# これを写して .env.local という名前にし、値を入れる（.env.local は git に入らない）
# 鍵が無いままでも動く（賢者は「デモ」の決まった返事をする）

# OpenAI の API キー（sk- で始まる。GEMu_Web と同じ鍵を使える）
OPENAI_API_KEY=

# 使うモデル（空なら GEMu_Web と同じ gpt-4.1-mini）
DXG_MODEL=

# 考える量（gpt-5 以降の、考えるモデルに替えたときだけ。none / minimal / low / medium / high）
# gpt-4.1-mini のときは空のままにする（入れると断られる）
DXG_REASONING_EFFORT=

# 金額に換算するときの1時間あたりの単価（円。空なら 5000）
DXG_HOURLY_COST=
